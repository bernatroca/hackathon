# Copia aquest fitxer a .env a l'arrel del repositori (cp app/xat/env.exemple .env)
# i posa-hi la clau. El .env no va mai a git.
# IA_PROVA=1                 # respon un text inventat, sense IA (per provar sense clau)
IA_URL=https://api.quiver.ai/v1
IA_CLAU=
IA_MODEL=arrow-2-telos
# Opcional: model de reserva si el principal falla abans de començar (fa servir la mateixa URL i clau).
IA_RESERVA_MODEL=arrow-2
